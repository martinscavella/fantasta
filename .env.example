# Password unica per l'accesso all'app (vedi src/proxy.ts + src/lib/auth.ts).
APP_PASSWORD=

# Chiave HMAC per firmare il cookie di sessione — minimo 32 caratteri casuali.
# Generane una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Token del Vercel Blob store privato (creato con `vercel blob store add`,
# o dal dashboard Vercel — Storage → Blob → Create → Private).
BLOB_READ_WRITE_TOKEN=

# Segreto per proteggere /api/cron/stats (Vercel Cron manda
# "Authorization: Bearer <CRON_SECRET>"). Stessa generazione di SESSION_SECRET.
CRON_SECRET=
