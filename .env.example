# Token del Vercel Blob store privato (creato con `vercel blob store add`,
# o dal dashboard Vercel — Storage → Blob → Create → Private).
BLOB_READ_WRITE_TOKEN=

# Segreto per proteggere /api/cron/stats (Vercel Cron manda
# "Authorization: Bearer <CRON_SECRET>"). Generane uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=
